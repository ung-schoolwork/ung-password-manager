# Local development. For deployment, use a MongoDB Atlas URI and the exact HTTPS origin.
# Keep credentials in .env.local, never in source control or NEXT_PUBLIC_* variables.
MONGODB_URI=mongodb://127.0.0.1:27017/ung_password_manager
# Optional in development (unset accepts any origin). Required in production.
APP_ORIGIN=http://localhost:3000

# Optional: comma-separated chrome-extension://<id> origins allowed to call the
# API alongside APP_ORIGIN. The ID below is the repository's unpacked extension
# (pinned by the key in extension/identity.ts). Without it, only APP_ORIGIN is
# accepted.
# EXTENSION_ORIGINS=chrome-extension://ibfocpogcdoolfmhcmnkiojgfpbkfbgj

# Required in production: a client-IP header your proxy always overwrites (e.g.
# x-real-ip, cf-connecting-ip). Without it, sign-in and registration are refused.
# AUTH_TRUSTED_IP_HEADER=x-real-ip

# Required for credential sharing. Generate with: openssl rand -base64 32
# SHARE_ENCRYPTION_KEY=

# Optional: ms before a copied credential is cleared from the clipboard
# (default 15000, clamped to 1000-60000). Leave unset in production.
# NEXT_PUBLIC_CLIPBOARD_CLEAR_MS=15000
