# Local development. For deployment, use a MongoDB Atlas URI and the exact HTTPS origin.
# Keep credentials in .env.local, never in source control or NEXT_PUBLIC_* variables.
MONGODB_URI=mongodb://127.0.0.1:27017/ung_password_manager
APP_ORIGIN=http://localhost:3000

# Production only: name a header overwritten by your trusted reverse proxy with
# one validated client IP (not a comma-separated forwarded chain). Never trust
# a client-supplied header. Production sign-in fails closed if this is missing.
# AUTH_TRUSTED_IP_HEADER=x-real-ip
